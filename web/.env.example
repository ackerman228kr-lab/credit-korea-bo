# --- Admin dashboard -------------------------------------------------------
# Password for /admin. REQUIRED in production (dev falls back to "admin").
ADMIN_PASSWORD=change-me
# Secret used to sign the admin session cookie (any long random string).
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# --- Supabase (optional) ---------------------------------------------------
# Without these, data is stored in ./.data/db.json (local / single-server only).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=valuation-photos
